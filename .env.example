# Copy this file to .env at the repository root. Never commit your real .env.
# Chat and vision: use a chat deployment that supports images for vision examples.
AZURE_OAI_ENDPOINT=https://your-chat-resource.openai.azure.com/
AZURE_OAI_KEY=replace-with-your-chat-key
AZURE_OAI_DEPLOYMENT=your-chat-deployment-name
AZURE_OAI_API_VERSION=2024-10-21

# Speech recognition and English translation: a Whisper-compatible deployment.
# Endpoint/key may belong to a different resource from chat.
AZURE_ASR_ENDPOINT=https://your-asr-resource.openai.azure.com/
AZURE_ASR_KEY=replace-with-your-asr-key
AZURE_ASR_DEPLOYMENT=your-whisper-deployment-name
AZURE_ASR_API_VERSION=2024-10-21

# Text-to-speech: use your deployment name, which need not equal the model ID.
AZURE_TTS_ENDPOINT=https://your-tts-resource.openai.azure.com/
AZURE_TTS_KEY=replace-with-your-tts-key
AZURE_TTS_DEPLOYMENT=your-tts-deployment-name
AZURE_TTS_API_VERSION=2025-03-01-preview
